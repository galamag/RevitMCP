{
  "name": "revit-mcp-server",
  "version": "0.1.0",
  "description": "MCP server that lets Claude build models in Autodesk Revit",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "node --test --test-timeout=60000 \"test/*.test.ts\"",
    "revit:can-close": "node dist/cli/can-close.js",
    "test:live": "node --test --test-concurrency=1 --test-timeout=120000 \"test/live/*.live.test.ts\""
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "typescript": "6.0.3"
  }
}
